CT_CONFIG_VERSION="4"
CT_OBSOLETE=y
CT_PARALLEL_JOBS=4
CT_LOAD="8"
CT_EXTRA_CFLAGS_FOR_HOST="-fno-char8_t"
CT_EXTRA_LDFLAGS_FOR_HOST="-fno-char8_t"
CT_ARCH_POWERPC=y
CT_ARCH_LE=y
CT_ARCH_64=y
CT_KERNEL_LINUX=y
CT_LINUX_V_3_10=y
CT_BINUTILS_V_2_46=y
CT_BINUTILS_PLUGINS=y
CT_GLIBC_V_2_17=y
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
# CT_GDB_CROSS_PYTHON is not set
CT_GDB_NATIVE=y
